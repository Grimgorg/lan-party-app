{
  "name": "lan-party-app",
  "productName": "LAN Party App",
  "version": "0.3.0",
  "description": "Desktop app for our LAN party group - AoE II DE rankings and more",
  "license": "MIT",
  "author": "Grimgorg",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "icon": "node scripts/make-icon.mjs"
  },
  "build": {
    "appId": "party.lan.app",
    "productName": "LAN Party App",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LAN-Party-App-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "LAN Party Group"
    },
    "artifactName": "LAN-Party-App-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "LAN-Party-App-Portable-${version}.${ext}"
    },
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "Grimgorg",
        "repo": "lan-party-app"
      }
    ]
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "electron-winstaller@5.4.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Grimgorg/lan-party-app.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.12"
  }
}
